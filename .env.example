# Environment Configuration
# Copy this to .env and fill in your values

PORT=5000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production_abc123xyz
JWT_EXPIRY=30m

# Database Configuration (Optional - for future use)
DATABASE_URL=mongodb://username:password@localhost:27017/hostel_db

# CORS Configuration
CORS_ORIGIN=https://kktourtravel.github.io

# Render Deployment
# If deploying on Render.com, these are automatically set
# But you can override them here if needed
